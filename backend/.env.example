# Backend configuration. Copy to .env and fill in real values.
# Never commit real credentials to version control.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/portfolio

# Application
SECRET_KEY=change-this-to-a-secure-random-value
DEBUG=True

# Google Gemini — required for the AI chatbot.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lead capture + chat access
# How long an unlocked chat session stays valid (hours)
CHAT_SESSION_HOURS=168
# Contact submissions allowed per window (per IP and per email)
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=900
# Chat messages allowed per window (per session)
CONVERSATION_RATE_LIMIT=20
CONVERSATION_RATE_WINDOW_SECONDS=300
# Repeat submissions with the same email inside this window reuse the lead
DUPLICATE_LEAD_WINDOW_HOURS=24

# Celery — background processing for captured leads.
# The default broker is a local SQLite file (no extra service in development).
# In production use Redis, e.g. redis://default:<password>@<host>:6379/0
CELERY_BROKER_URL=sqla+sqlite:///./celerybroker.sqlite3
CELERY_RESULT_BACKEND=db+sqlite:///./celeryresults.sqlite3
CELERY_TASK_ALWAYS_EAGER=False

# Optional: send an email to the owner whenever a lead arrives.
LEAD_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
