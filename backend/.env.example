# Backend configuration. Copy to .env and fill in real values.
# Never commit real credentials to version control.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres@127.0.0.1:5433/portfolio

# Application
SECRET_KEY=change-this-to-a-secure-random-value
DEBUG=True

# Google Gemini — required for the AI chatbot.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
